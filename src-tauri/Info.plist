<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Tray-only utility: no Dock tile, no menu bar. Equivalent to
       Electron's app.dock.hide(). -->
  <key>LSUIElement</key>
  <true/>
  <!-- 打开设置时切到 Regular 激活策略会短暂显示 Dock 图标；不显式声明
       这两个键时，Dock 悬浮名回退为可执行文件名（Cargo 包名小写 aispur）。
       固定为品牌大写 AISpur。 -->
  <key>CFBundleName</key>
  <string>AISpur</string>
  <key>CFBundleDisplayName</key>
  <string>AISpur</string>
</dict>
</plist>
